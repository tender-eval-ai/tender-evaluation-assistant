# GitHub Models (free tier) — https://github.com/marketplace/models
# Fine-grained PAT with account permission "Models: read"
GITHUB_TOKEN=github_pat_xxx

# OpenAI-compatible endpoint. For production local deployment, point this at vLLM, e.g.
# GITHUB_MODELS_BASE_URL=http://localhost:8000/v1
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

# Primary models plus comma-separated fallback chains, tried in order whenever the
# model before them fails (rate limit, outage, unsupported request).
# Production: TEXT_MODEL=Qwen3.6-35B-A3B, VISION_MODEL=Qwen3-VL-30B-A3B
TEXT_MODEL=openai/gpt-4o-mini
TEXT_MODEL_FALLBACKS=openai/o3,openai/gpt-4.1-mini
VISION_MODEL=openai/gpt-4.1
VISION_MODEL_FALLBACKS=openai/o3,openai/gpt-4.1-mini

# OpenAI-compatible LLM endpoint(s).
#
# Fallback entries are either "model" (served from GITHUB_MODELS_BASE_URL) or
# "model@base_url" (its own endpoint) — e.g. a cheap cloud primary with a local
# Ollama safety net:
#   TEXT_MODEL=deepseek-chat@https://api.deepseek.com/v1
#   TEXT_MODEL_FALLBACKS=qwen3:8b
#   DEEPSEEK_API_KEY=sk-...
# NOTE: any cloud primary means SYNTHETIC/SANITIZED documents only (NDA).
#
# Keyless local-only setup (Ollama, https://ollama.com):
#   ollama pull qwen3:8b && ollama pull qwen3-vl:8b
# Ollama serves models with a 4k-token context by default and silently truncates
# longer prompts — the agent's transcripts and full-bid prompts exceed that. Use a
# 16k variant for the text model:
#   printf 'FROM qwen3:8b\nPARAMETER num_ctx 16384\n' > Modelfile && ollama create qwen3:8b-16k -f Modelfile
#   TEXT_MODEL=qwen3:8b-16k
# (or start the server with OLLAMA_CONTEXT_LENGTH=16384).
# Inside Docker the host's Ollama is http://host.docker.internal:11434/v1; for CLI
# runs outside Docker use http://localhost:11434/v1.
# Production: point the base URL at vLLM on the client's hardware.
GITHUB_MODELS_BASE_URL=http://host.docker.internal:11434/v1
TEXT_MODEL=qwen3:8b
TEXT_MODEL_FALLBACKS=
VISION_MODEL=qwen3-vl:8b
VISION_MODEL_FALLBACKS=

# Gemini on Vertex AI — no key: OAuth via Application Default Credentials (run
# `gcloud auth application-default login`; on Cloud Run the service account). Both
# text and vision, e.g. (one line each):
#   TEXT_MODEL=google/gemini-2.5-flash@https://us-central1-aiplatform.googleapis.com/v1/projects/<project>/locations/us-central1/endpoints/openapi
#   VISION_MODEL=google/gemini-2.5-flash@https://us-central1-aiplatform.googleapis.com/v1/projects/<project>/locations/us-central1/endpoints/openapi
# Cost accounting: every call's tokens/seconds/$ are recorded per bid (work/usage/,
# GET /projects/{id}/usage). Prices are USD per 1M tokens; the built-in table
# (app/usage.py, verified 2026-09-09) can be overridden:
#   MODEL_PRICES={"google/gemini-2.5-flash": {"in": 0.30, "out": 2.50}, "deepseek-chat": {"in": 0.44, "cached_in": 0.014, "out": 1.32}}

# Hosted-endpoint keys, matched to chain entries by hostname (unused by Ollama/vLLM):
# DeepSeek api.deepseek.com | Gemini generativelanguage.googleapis.com/v1beta/openai
# | DashScope (Qwen) dashscope.aliyuncs.com/compatible-mode/v1 | Zhipu
# open.bigmodel.cn/api/paas/v4 | anything with "github" uses GITHUB_TOKEN.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
GITHUB_TOKEN=

# Service mode (backend/frontend). Shared secret sent as X-API-Key; REQUIRED on any
# machine that is not localhost-only. Generate one: openssl rand -hex 24
API_KEY=

# How many bids the backend extracts concurrently (default 4; 1 = sequential). With
# local models on one GPU, parallel bids only queue — and a local OCR page can then
# exceed the per-request timeout (default 600 s): raise LLM_TIMEOUT_S or use 1.
MAX_PARALLEL_BIDS=4
LLM_TIMEOUT_S=600
# Optional cap on generated tokens per call (a local 8B model in JSON mode was seen
# running away for 14k tokens); thinking models count reasoning against it.
# LLM_MAX_TOKENS=4096

# Evidence-search agent (runs only for findings still missing/unclear after the
# verification pass): AGENT_SEARCH=0 disables; step budget per finding; on-demand
# OCR budget per bid for pages beyond MAX_OCR_PAGES.
AGENT_SEARCH=1
AGENT_MAX_STEPS=8
AGENT_OCR_PAGES=6

# MCP server (python -m mcp_server.server). A project is served to an MCP client only
# if it was created with the "synthetic" flag — unless the operator declares that the
# connected client's model runs on-premises with MCP_LOCAL_MODEL=1 (the bundled local
# client, mcp_server/local_client.py, sets it itself; NEVER set it for Claude Desktop
# or Cursor: their models are in the cloud). The HTTP transport is off unless
# ALLOW_CLOUD_CLIENTS=1; it binds to loopback, needs API_KEY, serves synthetic only.
MCP_LOCAL_MODEL=0
ALLOW_CLOUD_CLIENTS=0
MCP_PORT=8765
# Model the local client drives the tools with (must be a local endpoint).
LOCAL_TEXT_MODEL=qwen3:8b@http://localhost:11434/v1

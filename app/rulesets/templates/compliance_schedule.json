{
  "id": "compliance_schedule",
  "form_name": "Compliance Schedule",
  "slots": [
    {
      "name": "default_delivery_days",
      "kind": "number",
      "unit": "days",
      "required": false,
      "description": "the delivery period, in days, that the tender sets as the default, when the Compliance Schedule lets the tenderer propose an earlier one"
    },
    {
      "name": "default_shelf_life_months",
      "kind": "number",
      "unit": "months",
      "required": false,
      "description": "the shelf life, in months, that the tender sets as the default, when the Compliance Schedule lets the tenderer propose a longer one"
    }
  ],
  "consequences": {
    "deemed_compliance": {
      "outcomes": {
        "blank": {
          "status": "pass",
          "note": "{field} is left blank, which counts as complying"
        },
        "filled": {
          "status": "pass"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        },
        "not_applicable": {
          "status": "pass",
          "note": "{field} is marked not applicable"
        }
      }
    },
    "critical": {
      "outcomes": {
        "blank": {
          "status": "disqualified",
          "note": "{field} is missing"
        },
        "filled": {
          "status": "pass"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        },
        "not_applicable": {
          "status": "needs_review",
          "note": "{field} is marked not applicable; a reviewer confirms it does not apply"
        }
      }
    },
    "mandatory_on_request": {
      "outcomes": {
        "blank": {
          "status": "dormant",
          "note": "{field} is missing; the Authority may ask for it",
          "follow_up": {
            "trigger": "the Authority asks for it in writing after the tender closes",
            "deadline": "within 5 working days of the request, unless the request gives another period",
            "if_deadline_missed": "disqualified"
          }
        },
        "filled": {
          "status": "pass"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        },
        "not_applicable": {
          "status": "pass",
          "note": "{field} is marked not applicable"
        }
      },
      "follow_up_deadline": {
        "op": "add_working_days",
        "offset": 5
      }
    },
    "discretionary": {
      "outcomes": {
        "blank": {
          "status": "pass",
          "note": "{field} is left blank; the Authority may ask for it later"
        },
        "filled": {
          "status": "pass"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        },
        "not_applicable": {
          "status": "pass",
          "note": "{field} is marked not applicable"
        }
      }
    }
  },
  "notes": [
    {
      "kind": "definition",
      "text": "What each Part covers (the mandatory features, delivery, packing and labelling, shelf life, ...) is set by each tender, so the rules check each Part's mark and the rule set says what the Part means."
    },
    {
      "kind": "consequence",
      "text": "A Part left blank counts as complying. A Part expressly marked as not complying excludes the tender."
    },
    {
      "kind": "reference",
      "text": "Beyond the mandatory features, the same exclusion applies to any other requirement the schedule asks the tenderer to confirm."
    },
    {
      "kind": "reference",
      "text": "Where the tenderer's and the manufacturer's information disagree, the manufacturer's is used, unless the tenderer resolves the difference when asked."
    }
  ],
  "rules": [
    {
      "id": "compliance_schedule.submitted",
      "check": "document_present",
      "field": "compliance_schedule.document",
      "consequence": "mandatory_on_request"
    },
    {
      "id": "compliance_schedule.part_a_not_marked_not_complying",
      "check": "contains",
      "field": "compliance_schedule.part_a",
      "stage": "II",
      "params": {
        "phrases": [
          "not comply",
          "not complied",
          "does not comply",
          "non-compliance",
          "non compliance",
          "not in compliance",
          "non-compliant"
        ],
        "absent": true
      },
      "outcomes": {
        "blank": {
          "status": "pass",
          "note": "{field} is left blank, which counts as complying"
        },
        "match": {
          "status": "pass"
        },
        "mismatch": {
          "status": "needs_review"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        }
      }
    },
    {
      "id": "compliance_schedule.part_b_not_marked_not_complying",
      "check": "contains",
      "field": "compliance_schedule.part_b",
      "stage": "II",
      "params": {
        "phrases": [
          "not comply",
          "not complied",
          "does not comply",
          "non-compliance",
          "non compliance",
          "not in compliance",
          "non-compliant"
        ],
        "absent": true
      },
      "outcomes": {
        "blank": {
          "status": "pass",
          "note": "{field} is left blank, which counts as complying"
        },
        "match": {
          "status": "pass"
        },
        "mismatch": {
          "status": "needs_review"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        }
      }
    },
    {
      "id": "compliance_schedule.part_c_not_marked_not_complying",
      "check": "contains",
      "field": "compliance_schedule.part_c",
      "stage": "II",
      "params": {
        "phrases": [
          "not comply",
          "not complied",
          "does not comply",
          "non-compliance",
          "non compliance",
          "not in compliance",
          "non-compliant"
        ],
        "absent": true
      },
      "outcomes": {
        "blank": {
          "status": "pass",
          "note": "{field} is left blank, which counts as complying"
        },
        "match": {
          "status": "pass"
        },
        "mismatch": {
          "status": "needs_review"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        }
      }
    },
    {
      "id": "compliance_schedule.part_d_not_marked_not_complying",
      "check": "contains",
      "field": "compliance_schedule.part_d",
      "stage": "II",
      "params": {
        "phrases": [
          "not comply",
          "not complied",
          "does not comply",
          "non-compliance",
          "non compliance",
          "not in compliance",
          "non-compliant"
        ],
        "absent": true
      },
      "outcomes": {
        "blank": {
          "status": "pass",
          "note": "{field} is left blank, which counts as complying"
        },
        "match": {
          "status": "pass"
        },
        "mismatch": {
          "status": "needs_review"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        }
      }
    },
    {
      "id": "compliance_schedule.no_part_marked_not_complying",
      "check": "tick_box",
      "field": "compliance_schedule.non_compliances",
      "stage": "II",
      "params": {
        "blank_if": [
          "nil",
          "none",
          "n/a",
          "not applicable",
          "no deviation",
          "no deviations"
        ]
      },
      "outcomes": {
        "blank": {
          "status": "pass"
        },
        "filled": {
          "status": "disqualified",
          "note": "the tenderer marks a requirement as not complied with: {field}"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        }
      }
    },
    {
      "id": "compliance_schedule.earlier_delivery_within_default",
      "check": "range",
      "field": "compliance_schedule.delivery_days",
      "params": {
        "max": "{default_delivery_days}"
      },
      "stage": "II",
      "condition": "the tenderer proposes a delivery period of its own",
      "outcomes": {
        "blank": {
          "status": "pass",
          "note": "{field} is not stated, so the default delivery period applies"
        },
        "match": {
          "status": "pass"
        },
        "mismatch": {
          "status": "needs_review"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        }
      }
    },
    {
      "id": "compliance_schedule.longer_shelf_life_beyond_default",
      "check": "range",
      "field": "compliance_schedule.shelf_life_months",
      "params": {
        "min": "{default_shelf_life_months}"
      },
      "stage": "II",
      "condition": "the tenderer proposes a shelf life of its own",
      "outcomes": {
        "blank": {
          "status": "pass",
          "note": "{field} is not stated, so the default shelf life applies"
        },
        "match": {
          "status": "pass"
        },
        "mismatch": {
          "status": "needs_review"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        }
      }
    },
    {
      "id": "compliance_schedule.authority_satisfied",
      "check": "human_only",
      "field": "compliance_schedule.document",
      "stage": "II",
      "outcomes": {
        "unstated": {
          "status": "needs_review"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        }
      },
      "note": "whatever the tenderer declares, the Authority must itself be satisfied that the goods meet every mandatory feature"
    }
  ]
}

{
  "id": "price_schedule_parts_c_d",
  "form_name": "Price Schedule, Parts C and D",
  "consequences": {
    "deemed_default": {
      "outcomes": {
        "blank": {
          "status": "pass",
          "note": "{field} is left blank, so the form's default applies"
        },
        "filled": {
          "status": "pass"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        },
        "not_applicable": {
          "status": "pass",
          "note": "{field} is marked not applicable"
        }
      }
    },
    "discretionary": {
      "outcomes": {
        "blank": {
          "status": "pass",
          "note": "{field} is left blank; the Authority may ask for it later"
        },
        "filled": {
          "status": "pass"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        },
        "not_applicable": {
          "status": "pass",
          "note": "{field} is marked not applicable"
        }
      }
    }
  },
  "notes": [
    {
      "kind": "consequence",
      "text": "A discount left blank is read as no discount (Nil)."
    },
    {
      "kind": "definition",
      "text": "A discount period runs from the later of the day the invoice is received and the day payment falls due."
    },
    {
      "kind": "definition",
      "text": "A discount is written with at most two decimal places."
    },
    {
      "kind": "definition",
      "text": "Part D asks for the bank account payments go to: the bank's name and address, the account name and number, and the sorting code."
    }
  ],
  "rules": [
    {
      "id": "price_schedule_parts_c_d.discount_7day_given",
      "check": "filled",
      "field": "price_schedule_parts_c_d.discount_7day",
      "consequence": "deemed_default"
    },
    {
      "id": "price_schedule_parts_c_d.discount_8to14day_given",
      "check": "filled",
      "field": "price_schedule_parts_c_d.discount_8to14day",
      "consequence": "deemed_default"
    },
    {
      "id": "price_schedule_parts_c_d.bank_details_given",
      "check": "filled",
      "field": "price_schedule_parts_c_d.part_d",
      "consequence": "discretionary",
      "condition": "the tenderer is based outside the jurisdiction and will be paid by telegraphic transfer"
    },
    {
      "id": "price_schedule_parts_c_d.discount_7day_two_decimals",
      "check": "range",
      "field": "price_schedule_parts_c_d.discount_7day",
      "params": {
        "max_decimals": 2
      },
      "depends_on": [
        "price_schedule_parts_c_d.discount_7day_given"
      ],
      "outcomes": {
        "blank": {
          "status": "pass"
        },
        "match": {
          "status": "pass"
        },
        "mismatch": {
          "status": "needs_review"
        }
      }
    },
    {
      "id": "price_schedule_parts_c_d.discount_8to14day_two_decimals",
      "check": "range",
      "field": "price_schedule_parts_c_d.discount_8to14day",
      "params": {
        "max_decimals": 2
      },
      "depends_on": [
        "price_schedule_parts_c_d.discount_8to14day_given"
      ],
      "outcomes": {
        "blank": {
          "status": "pass"
        },
        "match": {
          "status": "pass"
        },
        "mismatch": {
          "status": "needs_review"
        }
      }
    }
  ]
}

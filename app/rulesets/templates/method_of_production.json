{
  "id": "method_of_production",
  "form_name": "Method of Production Statement",
  "consequences": {
    "mandatory_on_request": {
      "outcomes": {
        "blank": {
          "status": "dormant",
          "note": "{field} is missing; the Authority may ask for it",
          "follow_up": {
            "trigger": "the Authority asks for it in writing after the tender closes",
            "deadline": "within 5 working days of the request, unless the request gives another period",
            "if_deadline_missed": "disqualified"
          }
        },
        "filled": {
          "status": "pass"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        },
        "not_applicable": {
          "status": "pass",
          "note": "{field} is marked not applicable"
        }
      },
      "follow_up_deadline": {
        "op": "add_working_days",
        "offset": 5
      }
    },
    "critical": {
      "outcomes": {
        "blank": {
          "status": "disqualified",
          "note": "{field} is missing"
        },
        "filled": {
          "status": "pass"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        },
        "not_applicable": {
          "status": "needs_review",
          "note": "{field} is marked not applicable; a reviewer confirms it does not apply"
        }
      }
    },
    "discretionary": {
      "outcomes": {
        "blank": {
          "status": "pass",
          "note": "{field} is left blank; the Authority may ask for it later"
        },
        "filled": {
          "status": "pass"
        },
        "redacted": {
          "status": "needs_review",
          "note": "{field} is covered in this copy; a reviewer checks the original"
        },
        "not_applicable": {
          "status": "pass",
          "note": "{field} is marked not applicable"
        }
      }
    }
  },
  "notes": [
    {
      "kind": "definition",
      "text": "The tenderer's statement of how the goods are made. Not from the rule files: written for the joint project (J12)."
    }
  ],
  "rules": [
    {
      "id": "method_of_production.submitted",
      "check": "document_present",
      "field": "method_of_production.document",
      "consequence": "mandatory_on_request"
    },
    {
      "id": "method_of_production.statement_given",
      "check": "filled",
      "field": "method_of_production.statement",
      "consequence": "mandatory_on_request",
      "depends_on": [
        "method_of_production.submitted"
      ]
    }
  ]
}

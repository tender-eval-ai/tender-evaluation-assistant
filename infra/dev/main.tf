# Resources inside the tender-review-dev account. Runs with the shared dev-admin profile;
# needs no access to the company (the company) account.

terraform {
  required_version = ">= 1.10"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }

  # terraform init -backend-config=../backend.hcl
  backend "s3" {
    key = "dev/terraform.tfstate"
  }
}

variable "profile" {
  description = "AWS CLI SSO profile with DevAdmin in the project account."
  type        = string
  default     = "dev-admin"
}

variable "dev_account_id" {
  description = "tender-review-dev account ID (from the company layer's project_handover output)."
  type        = string
}

variable "data_region" {
  description = "Region for project resources."
  type        = string
}

variable "synthetic_bucket_name" {
  description = "Must match synthetic_bucket_name in the company layer, which grants DevSyntheticData access to it."
  type        = string
}

provider "aws" {
  region              = var.data_region
  profile             = var.profile
  allowed_account_ids = [var.dev_account_id]

  default_tags {
    tags = {
      managed-by  = "terraform"
      project     = "tender-review"
      environment = "dev"
    }
  }
}

# ---------------------------------------------------------------- synthetic-data bucket

resource "aws_s3_bucket" "synthetic" {
  bucket = var.synthetic_bucket_name

  tags = {
    data-class = "synthetic"
  }

  lifecycle {
    prevent_destroy = true
  }
}

resource "aws_s3_bucket_ownership_controls" "synthetic" {
  bucket = aws_s3_bucket.synthetic.id
  rule {
    object_ownership = "BucketOwnerEnforced"
  }
}

resource "aws_s3_bucket_public_access_block" "synthetic" {
  bucket                  = aws_s3_bucket.synthetic.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_versioning" "synthetic" {
  bucket = aws_s3_bucket.synthetic.id
  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "synthetic" {
  bucket = aws_s3_bucket.synthetic.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_lifecycle_configuration" "synthetic" {
  bucket = aws_s3_bucket.synthetic.id

  rule {
    id     = "expire-old-versions"
    status = "Enabled"

    filter {}

    noncurrent_version_expiration {
      noncurrent_days = 90
    }

    abort_incomplete_multipart_upload {
      days_after_initiation = 7
    }
  }

  depends_on = [aws_s3_bucket_versioning.synthetic]
}

data "aws_iam_policy_document" "synthetic" {
  statement {
    sid     = "DenyInsecureTransport"
    effect  = "Deny"
    actions = ["s3:*"]
    resources = [
      aws_s3_bucket.synthetic.arn,
      "${aws_s3_bucket.synthetic.arn}/*",
    ]
    principals {
      type        = "*"
      identifiers = ["*"]
    }
    condition {
      test     = "Bool"
      variable = "aws:SecureTransport"
      values   = ["false"]
    }
  }
}

resource "aws_s3_bucket_policy" "synthetic" {
  bucket     = aws_s3_bucket.synthetic.id
  policy     = data.aws_iam_policy_document.synthetic.json
  depends_on = [aws_s3_bucket_public_access_block.synthetic]
}

resource "aws_s3_object" "readme" {
  bucket       = aws_s3_bucket.synthetic.id
  key          = "README.md"
  content_type = "text/markdown"
  content      = <<-EOT
    # tender-review synthetic data

    Synthetic data only. Generated by tools/make_demo_case.py (or written by hand).
    No real tender or bid material, no redacted real samples.

    Layout:
    - cases/<case-name>/   generated tender and bid PDFs with ground truth
    - evals/<date>/        eval outputs on synthetic data
    - load/                load-test inputs
  EOT

  depends_on = [aws_s3_bucket_server_side_encryption_configuration.synthetic]
}

output "synthetic_bucket" {
  value = aws_s3_bucket.synthetic.id
}

output "console_link" {
  value = "https://s3.console.aws.amazon.com/s3/buckets/${aws_s3_bucket.synthetic.id}"
}
